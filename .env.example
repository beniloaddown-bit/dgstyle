# Copy this to .env for local development and replace values
# Do NOT commit your real keys to git.

# Internal key exposed to the frontend (Vite will make VITE_ prefixed vars available in import.meta.env)
VITE_INTERNAL_API_KEY=change_me_to_a_secure_value

# App URLs used for redirects and webhook callbacks
PUBLIC_SITE_URL=http://localhost:5173
WAVE_SUCCESS_URL=http://localhost:5173/paiement?status=success
WAVE_ERROR_URL=http://localhost:5173/paiement?status=error
ORANGE_SUCCESS_URL=http://localhost:5173/paiement?status=success
ORANGE_ERROR_URL=http://localhost:5173/paiement?status=error
ORANGE_NOTIFICATION_URL=http://localhost:5173/api/payments/webhook/orange

# PayDunya credentials (preferred for Orange Money / Wave / Moov in Senegal)
PAYDUNYA_MODE=test
PAYDUNYA_API_BASE=https://app.paydunya.com/sandbox-api/v1
PAYDUNYA_MASTER_KEY=your_paydunya_master_key
PAYDUNYA_PRIVATE_KEY=your_paydunya_private_key
PAYDUNYA_TOKEN=your_paydunya_token

# Wave credentials (matching AidaGateway config names)
WAVE_API_KEY=your_wave_api_key
WAVE_API_SECRET=your_wave_api_secret
WAVE_API_BASE=https://api.wave.com
WAVE_CURRENCY=XOF

# Orange Money credentials (matching AidaGateway config names)
ORANGE_API_BASE=https://api.orange.com/orange-money-webpay
ORANGE_CLIENT_ID=your_orange_client_id
ORANGE_CLIENT_SECRET=your_orange_client_secret
ORANGE_MERCHANT_KEY=your_orange_merchant_key
ORANGE_CURRENCY=XOF

# Legacy aliases kept for compatibility with the current app
ORANGE_MERCHANT_ID=your_orange_merchant_key
AIDA_WAVE_API_KEY=your_wave_api_key
AIDA_WAVE_API_SECRET=your_wave_api_secret
AIDA_WAVE_API_URL=https://api.wave.com
AIDA_WAVE_CURRENCY=XOF
AIDA_ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay
AIDA_ORANGE_MONEY_API_USERNAME=your_orange_client_id
AIDA_ORANGE_MONEY_API_PASSWORD=your_orange_client_secret
AIDA_ORANGE_MONEY_MERCHANT_KEY=your_orange_merchant_key

# Phone number used for receiving payments (international format suggested)
RECEIVER_PHONE=773813334
